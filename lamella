#!/usr/bin/env bash
#
# lamella - thin wrapper for the common Lamella flows.
#
# Usage:
#   ./lamella list [plugins|codex|all]
#   ./lamella validate [all|skills|skill-packages]
#   ./lamella build-marketplace
#   ./lamella build-repo-marketplace
#   ./lamella build-codex
#   ./lamella scaffold skill <category>/<name> --description "..."
#   ./lamella install [options] [plugin-names...]
#   ./lamella install-codex [options] [skill-or-agent-names...]
#   ./lamella uninstall [plugin-names...]
#   ./lamella update [claude|codex|all]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat <<EOF
lamella - common Lamella operations

USAGE
    ./lamella <command> [args...]

COMMANDS
    list [plugins|codex|all]   List available built plugins, Codex skills, or Codex agents
    validate [surface]         Run Lamella validators (`all`, `skills`, `skill-packages`)
    build-marketplace          Build the Claude plugin marketplace
    build-codex                Build and export Codex skills and agents
    scaffold skill ...         Scaffold a Lamella skill directory from the template
    install [args...]          Install Claude plugins
    install-codex [args...]    Install Codex skills and agents
    uninstall [args...]        Remove installed Claude plugins
    update [claude|codex|all]  Refresh generated outputs
    preset <subcommand>        Manage workflow presets (list, show, install)

EXAMPLES
    ./lamella list
    ./lamella install core typescript
    ./lamella install --dry-run typescript
    ./lamella install --preset explore-codebase
    ./lamella install --preset stipe-package-repair
    ./lamella preset list
    ./lamella preset show tdd-cycle
    ./lamella scaffold skill meta/my-new-skill --description "Guides ..."
    ./lamella build-repo-marketplace
    ./lamella install-codex --all
    ./lamella update
EOF
    exit 0
}

run_validate() {
    case "${1:-all}" in
        all)
            exec bash "$SCRIPT_DIR/scripts/ci/run-validate-suite.sh"
            ;;
        skills)
            exec node "$SCRIPT_DIR/scripts/ci/validate-skills.js"
            ;;
        skill-packages)
            exec node "$SCRIPT_DIR/scripts/ci/validate-skill-packages.js"
            ;;
        *)
            usage
            ;;
    esac
}

install_usage() {
    cat <<EOF
lamella install - install Claude plugins

USAGE
    ./lamella install [options] [plugin-names...]
    ./lamella install --preset <name> [install-options]

OPTIONS
    -a, --all         Install every available plugin
    -l, --list        List available plugins
    -n, --dry-run     Show the resolved build/install order
    --refresh         Re-detect tools and re-evaluate installed plugins
    --preset <name>   Install a Lamella-owned preset surface by name
    -h, --help        Show this help

EXAMPLES
    ./lamella install core python
    ./lamella install --dry-run typescript
    ./lamella install --preset stipe-package-repair
    ./lamella install --preset stipe-package-repair --dry-run

NOTE
    Preset surfaces are Lamella-owned. Callers may select a named preset,
    but Lamella remains the source of truth for package composition.
EOF
    exit 0
}

generated_codex_manifest_dir() {
    echo "$SCRIPT_DIR/dist/generated/codex-manifests"
}

build_codex_exports() {
    local manifest_dir
    manifest_dir="$(generated_codex_manifest_dir)"
    local output_dir="${1:-}"

    rm -rf "$manifest_dir"
    mkdir -p "$manifest_dir"

    bash "$SCRIPT_DIR/builders/sync-codex-manifests.sh" "$manifest_dir"
    if [[ -n "$output_dir" ]]; then
        bash "$SCRIPT_DIR/builders/build-codex-skills.sh" "$manifest_dir" "$output_dir"
    else
        bash "$SCRIPT_DIR/builders/build-codex-skills.sh" "$manifest_dir"
    fi
}

run_update() {
    case "${1:-all}" in
        all)
            bash "$SCRIPT_DIR/builders/build-claude-marketplace.sh"
            build_codex_exports
            ;;
        claude|plugins)
            bash "$SCRIPT_DIR/builders/build-claude-marketplace.sh"
            ;;
        codex|skills)
            build_codex_exports
            ;;
        *)
            usage
            ;;
    esac
}

run_list() {
    case "${1:-plugins}" in
        plugins|claude|plugin)
            bash "$SCRIPT_DIR/install.sh" --list
            ;;
        codex|skills)
            bash "$SCRIPT_DIR/install-codex.sh" --list
            ;;
        all)
            bash "$SCRIPT_DIR/install.sh" --list
            echo ""
            bash "$SCRIPT_DIR/install-codex.sh" --list
            ;;
        *)
            usage
            ;;
    esac
}

main() {
    # Handle install --preset by routing to preset.sh install
    if [[ "${1:-}" == "install" ]]; then
        local preset_name=""
        local saw_preset=false
        local other_args=()
        shift
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -h|--help)
                    install_usage
                    ;;
                --preset)
                    saw_preset=true
                    shift
                    preset_name="${1:-}"
                    if [[ -z "$preset_name" ]]; then
                        echo "lamella: missing preset name for --preset" >&2
                        exit 1
                    fi
                    shift
                    ;;
                *)
                    other_args+=("$1")
                    shift
                    ;;
            esac
        done
        if [[ -n "$preset_name" ]]; then
            exec bash "$SCRIPT_DIR/scripts/plugins/preset.sh" install "$preset_name" "${other_args[@]+"${other_args[@]}"}"
        fi
        if [[ "$saw_preset" == true ]]; then
            echo "lamella: missing preset name for --preset" >&2
            exit 1
        fi
        exec bash "$SCRIPT_DIR/install.sh" "${other_args[@]+"${other_args[@]}"}"
    fi

    case "${1:-}" in
        ""|-h|--help|help)
            usage
            ;;
        list)
            shift
            run_list "${1:-plugins}"
            ;;
        validate)
            shift
            run_validate "${1:-all}"
            ;;
        build-marketplace|build)
            shift
            exec bash "$SCRIPT_DIR/builders/build-claude-marketplace.sh" "$@"
            ;;
        build-repo-marketplace)
            shift
            exec bash "$SCRIPT_DIR/builders/build-claude-marketplace.sh" \
                --catalog-only \
                --output-dir "$SCRIPT_DIR" \
                --source-mode git-subdir \
                --git-url "https://github.com/basidiocarp/lamella.git" \
                --git-ref gh-pages \
                "$@"
            ;;
        build-codex)
            shift
            build_codex_exports "${1:-}"
            ;;
        scaffold)
            shift
            case "${1:-}" in
                skill)
                    shift
                    exec bash "$SCRIPT_DIR/scripts/scaffold/create-skill.sh" "$@"
                    ;;
                *)
                    usage
                    ;;
            esac
            ;;
        install-codex)
            shift
            exec bash "$SCRIPT_DIR/install-codex.sh" "$@"
            ;;
        uninstall)
            shift
            exec bash "$SCRIPT_DIR/scripts/plugins/install-plugin.sh" --uninstall "$@"
            ;;
        preset)
            shift
            exec bash "$SCRIPT_DIR/scripts/plugins/preset.sh" "$@"
            ;;
        update)
            shift
            run_update "${1:-all}"
            ;;
        *)
            usage
            ;;
    esac
}

main "$@"
