{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lamella.dev/plugin-manifest.schema.json",
  "title": "Plugin Manifest",
  "description": "Schema for Skill-Issue plugin manifests",
  "type": "object",
  "required": ["name", "version", "description"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Plugin identifier (lowercase, hyphens allowed)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g., 1.0.0)"
    },
    "description": {
      "type": "string",
      "description": "Brief description of what the plugin provides"
    },
    "author": {
      "type": "string",
      "description": "Plugin author or maintainer"
    },
    "license": {
      "type": "string",
      "default": "MIT",
      "description": "License identifier"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Searchable tags for discovery"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Other plugin names this depends on",
      "default": []
    },
    "resources": {
      "type": "object",
      "description": "Plugin resources to include",
      "properties": {
        "rules": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Rule files (relative to rules/)"
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Skill directory names (relative to skills/)"
        },
        "agents": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Agent files (relative to agents/)"
        },
        "commands": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Command files (relative to commands/)"
        },
        "workflows": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Workflow files (relative to workflows/)"
        },
        "hooks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Hook script files (relative to scripts/hooks/)"
        },
        "templates": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Template files (relative to templates/)"
        },
        "scripts": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Utility scripts (relative to scripts/)"
        },
        "mcp-configs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "MCP configuration files"
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "description": "Plugin-specific configuration options",
      "additionalProperties": true
    },
    "install": {
      "type": "object",
      "description": "Installation hooks",
      "properties": {
        "pre": {
          "type": "string",
          "description": "Script to run before install"
        },
        "post": {
          "type": "string",
          "description": "Script to run after install"
        }
      }
    }
  },
  "additionalProperties": false
}
